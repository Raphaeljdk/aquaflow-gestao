generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  FUNCIONARIO
  GERENTE
  ATENDENTE
  LAVADOR
}
enum TipoVeiculo {
  CARRO
  MOTO
  CAMINHONETE
}
enum StatusComanda {
  AGUARDANDO
  EM_LAVAGEM
  FINALIZADO
  ENTREGUE
  CANCELADO
}
enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
}
enum StatusAgendamento {
  AGENDADO
  CONVERTIDO
  CANCELADO
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  password String
  role Role @default(FUNCIONARIO)
  ativo Boolean @default(true)
  funcionarioId String? @unique
  funcionario Funcionario? @relation(fields:[funcionarioId], references:[id], onDelete:Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Cliente {
  id String @id @default(cuid())
  nome String
  telefone String
  email String @default("")
  cpfCnpj String? @unique
  endereco String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  veiculos Veiculo[]
  comandas Comanda[]
  agendamentos Agendamento[]
  @@index([nome])
  @@index([telefone])
}
model Veiculo {
  id String @id @default(cuid())
  placa String @unique
  marca String
  modelo String
  cor String
  ano Int
  tipo TipoVeiculo @default(CARRO)
  clienteId String
  cliente Cliente @relation(fields:[clienteId],references:[id],onDelete:Restrict)
  comandas Comanda[]
  agendamentos Agendamento[]
  @@index([clienteId])
}
model Servico {
  id String @id @default(cuid())
  nome String
  descricao String @default("")
  preco Decimal @db.Decimal(12,2)
  duracaoMin Int
  ativo Boolean @default(true)
  itens ItemComanda[]
  agendamentos AgendamentoServico[]
}
model Funcionario {
  id String @id @default(cuid())
  nome String
  email String @default("")
  cargo Role @default(FUNCIONARIO)
  comissao Decimal @default(0) @db.Decimal(5,2)
  ativo Boolean @default(true)
  user User?
  comandas Comanda[]
}
model Comanda {
  id String @id @default(cuid())
  numero Int @unique @default(autoincrement())
  clienteId String
  cliente Cliente @relation(fields:[clienteId],references:[id],onDelete:Restrict)
  veiculoId String
  veiculo Veiculo @relation(fields:[veiculoId],references:[id],onDelete:Restrict)
  status StatusComanda @default(AGUARDANDO)
  total Decimal @db.Decimal(12,2)
  desconto Decimal @default(0) @db.Decimal(12,2)
  formaPagamento FormaPagamento?
  observacoes String @default("")
  vistoria Json?
  funcionarioId String?
  funcionario Funcionario? @relation(fields:[funcionarioId],references:[id],onDelete:Restrict)
  comissao Decimal @default(0) @db.Decimal(12,2)
  comissaoPercentual Decimal @default(0) @db.Decimal(5,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  finalizadoEm DateTime?
  pagoEm DateTime?
  itens ItemComanda[]
  agendamento Agendamento?
  @@index([createdAt])
  @@index([finalizadoEm])
  @@index([status,funcionarioId])
}
model ItemComanda {
  id String @id @default(cuid())
  comandaId String
  comanda Comanda @relation(fields:[comandaId],references:[id],onDelete:Cascade)
  servicoId String
  servico Servico @relation(fields:[servicoId],references:[id],onDelete:Restrict)
  nome String
  preco Decimal @db.Decimal(12,2)
  quantidade Int @default(1)
  @@index([comandaId])
}
model Agendamento {
  id String @id @default(cuid())
  clienteId String
  cliente Cliente @relation(fields:[clienteId],references:[id],onDelete:Restrict)
  veiculoId String
  veiculo Veiculo @relation(fields:[veiculoId],references:[id],onDelete:Restrict)
  dataHora DateTime @db.Timestamptz(3)
  fim DateTime @db.Timestamptz(3)
  status StatusAgendamento @default(AGENDADO)
  observacoes String @default("")
  comandaId String? @unique
  comanda Comanda? @relation(fields:[comandaId],references:[id],onDelete:Restrict)
  servicos AgendamentoServico[]
  @@index([dataHora,status])
}
model AgendamentoServico {
  agendamentoId String
  servicoId String
  agendamento Agendamento @relation(fields:[agendamentoId],references:[id],onDelete:Cascade)
  servico Servico @relation(fields:[servicoId],references:[id],onDelete:Restrict)
  @@id([agendamentoId,servicoId])
}
model Configuracao {
  id String @id @default("empresa")
  nome String @default("Ducha Elitte")
  cnpj String @default("")
  endereco String @default("")
  telefone String @default("")
  pixChave String @default("")
  logo String @default("")
  manualVideoUrl String @default("")
  manualPdfUrl String @default("")
  abertura String @default("08:00")
  fechamento String @default("18:00")
  intervaloMin Int @default(30)
  diasSemana Int[] @default([1,2,3,4,5,6])
  timezone String @default("America/Sao_Paulo")
}
model LoginAttempt {
  key String @id
  attempts Int @default(1)
  expiresAt DateTime
}
model Material {
  id String @id @default(cuid())
  nome String @unique
  unidade String
  quantidade Decimal @default(0) @db.Decimal(15,3)
  minimo Decimal @default(0) @db.Decimal(15,3)
  custoUnitario Decimal @default(0) @db.Decimal(12,2)
  ativo Boolean @default(true)
  movimentos MovimentoEstoque[]
}
model MovimentoEstoque {
  id String @id @default(cuid())
  materialId String
  material Material @relation(fields:[materialId],references:[id],onDelete:Restrict)
  tipo String
  quantidade Decimal @db.Decimal(15,3)
  observacao String @default("")
  createdAt DateTime @default(now())
  @@index([materialId,createdAt])
}

enum StatusSolicitacaoEmpresa {
  PENDENTE
  EM_ANALISE
  APROVADO
  REJEITADO
}

model SolicitacaoEmpresa {
  id String @id @default(cuid())
  nomeEmpresa String
  cnpj String @default("")
  razaoSocial String @default("")
  nomeResponsavel String
  email String @unique
  whatsapp String
  cidade String
  mensagem String @default("")
  formaPagamentoPrevista String @default("CARTAO_DEBITO")
  mensalidadeCentavos Int?
  cienciaCondicoesComerciaisEm DateTime?
  status StatusSolicitacaoEmpresa @default(PENDENTE)
  origemHash String
  consentimentoEm DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisadoEm DateTime?
  revisadoPor String?
  observacoesInternas String @default("")
  @@index([status, createdAt])
  @@index([origemHash, createdAt])
}

/** Lista curada pela administração; aprovação de cadastro não publica automaticamente um parceiro. */
model ParceiroLavaRapido {
  id String @id @default(cuid())
  nome String
  cidade String @default("")
  whatsapp String
  ativo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ativo, nome])
}

enum StatusPedidoAgendamento {
  PENDENTE
  CONFIRMADO
  RECUSADO
}

/** Pedidos públicos desta instância, pendentes até validação pela equipe. */
model PedidoAgendamentoPublico {
  id String @id @default(cuid())
  nome String
  telefone String
  tipo TipoVeiculo
  placa String
  descricaoVeiculo String
  servicoId String
  dataHora DateTime @db.Timestamptz(3)
  observacoes String @default("")
  status StatusPedidoAgendamento @default(PENDENTE)
  origemHash String
  agendamentoId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([origemHash, createdAt])
}

enum StatusChamado {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
  FECHADO
}

enum CategoriaChamado {
  ERRO
  DUVIDA
  MELHORIA
  FINANCEIRO
  OUTRO
}

enum PrioridadeChamado {
  NORMAL
  ALTA
}

enum AutorMensagemChamado {
  SOLICITANTE
  SUPORTE
}

/** Atendimento entre a unidade desta instância e a administração da plataforma. */
model ChamadoSuporte {
  id String @id @default(cuid())
  empresaNome String
  empresaCnpj String @default("")
  criadoPorId String
  criadoPorNome String
  criadoPorEmail String
  titulo String
  categoria CategoriaChamado
  prioridade PrioridadeChamado @default(NORMAL)
  status StatusChamado @default(ABERTO)
  mensagens MensagemChamado[]
  ultimaRespostaEm DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([criadoPorId, createdAt])
}

model MensagemChamado {
  id String @id @default(cuid())
  chamadoId String
  chamado ChamadoSuporte @relation(fields:[chamadoId], references:[id], onDelete:Cascade)
  autorTipo AutorMensagemChamado
  autorId String
  autorNome String
  texto String
  createdAt DateTime @default(now())
  @@index([chamadoId, createdAt])
}
