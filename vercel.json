{
  "framework": "nextjs",
  "buildCommand": "npm run build:app",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/saas-provision",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/saas-expiry",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/saas-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/saas-legacy-link",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/saas-recover-invites",
      "schedule": "*/10 * * * *"
    }
  ],
  "ignoreCommand": "sh -c 'if [ \"$VERCEL_ENV\" = \"production\" ] && printf \"%s\" \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -q \"\\[release\\]\"; then exit 1; fi; exit 0'"
}
